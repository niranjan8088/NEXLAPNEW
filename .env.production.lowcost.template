# Nex LapTech - Low-Cost Enterprise Production Environment Template
# Save as `.env.production` on VPS deployment

# Server Ports & Node Environment
PORT=3000
BACKEND_PORT=3001
NODE_ENV=production

# Application Domains
NEXT_PUBLIC_SITE_URL=https://www.nexbyte.com
NEXT_PUBLIC_API_URL=https://api.nexbyte.com
CORS_ALLOWED_ORIGINS=https://www.nexbyte.com,https://nexbyte.com,https://api.nexbyte.com

# Supabase Credentials (Free Tier Database, Auth, Realtime & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Buckets (Images, Certificates, Invoices, PDFs)
SUPABASE_STORAGE_BUCKET=nexbyte-assets

# Security & Admin Secrets
JWT_SECRET=your-32-character-secret-key-change-in-production
ADMIN_EMAILS=admin@nexbyte.com,nexbytetechnologies@gmail.com

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
