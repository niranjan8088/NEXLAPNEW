# NEXBYTE TECHNOLOGIES - Production Environment Variables Template
# Copy this file to `.env.production` or configure in Vercel Project Settings

# Application Site URL (Used for CORS, redirects, and canonical links)
NEXT_PUBLIC_APP_URL=https://nexbyte360.com
NEXT_PUBLIC_SITE_URL=https://nexbyte360.com

# Supabase Credentials (PostgreSQL DB + Auth + Realtime + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security & Access Control
ADMIN_EMAILS=admin@nexbyte.com,info@nexbytetechnologies.com
JWT_SECRET=your-secure-jwt-secret-min-32-characters

# CORS Setup
CORS_ALLOWED_ORIGINS=https://nexbyte360.com,https://www.nexbyte360.com

# Optional SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
EMAIL_FROM=info@nexbytetechnologies.com

# Google Gemini AI Integration
GEMINI_API_KEY=your-google-gemini-api-key-here
