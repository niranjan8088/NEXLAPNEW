# ============================================================
# NEXLAPTECH — Environment Variables Template
# Copy to .env.local for development (never commit real values)
# Set all values in GoDaddy's Environment Variables panel for production
# ============================================================

# ── Site URL ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nexlaptech.in
NEXT_PUBLIC_APP_URL=https://nexlaptech.in

# ── Supabase (PostgreSQL + Auth + Storage + Realtime) ────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Aliases used by backend and upload route (set same values)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Google Gemini AI ──────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Rotate this key before deploying if previously exposed
GEMINI_API_KEY=your-google-gemini-api-key-here

# ── Admin Access Control ──────────────────────────────────────
# Comma-separated list of emails allowed to log in as admin
ADMIN_EMAILS=admin@nexlaptech.in
# Required in production — any password succeeds without this
ADMIN_PASSWORD=your-strong-admin-password-min-16-chars

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=production

# ── CORS (Express backend only — not needed for Next.js) ─────
# Only required if you deploy the separate backend/ Express server
CORS_ALLOWED_ORIGINS=https://nexlaptech.in,https://www.nexlaptech.in
BACKEND_PORT=3001
