# Nex LapTech - Enterprise Production Environment Variables
# Copy to `.env.production` on VPS deployment

# Server Ports
PORT=3000
BACKEND_PORT=3001
NODE_ENV=production

# Supabase Credentials (Database + Auth + Realtime + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application URLs & CORS
NEXT_PUBLIC_SITE_URL=https://nexbyte.com
CORS_ALLOWED_ORIGINS=https://nexbyte.com,https://www.nexbyte.com,http://localhost:3000

# Admin Access Control
ADMIN_EMAILS=admin@nexbyte.com,info@nexbytetechnologies.com
JWT_SECRET=your-super-secret-jwt-token-key-change-in-production-min-32-chars

# Cloud Storage / CDN Config (Optional S3/R2/Supabase Bucket)
STORAGE_BUCKET_NAME=nexbyte-assets
STORAGE_CDN_URL=https://cdn.nexbyte.com

# SMTP / Email Notification Service (Postmark / SendGrid / Amazon SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
EMAIL_FROM=info@nexbytetechnologies.com

# WhatsApp API (Twilio / Meta Business API)
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
